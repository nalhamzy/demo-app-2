# Required: Anthropic API key for the decision + tuning layer
ANTHROPIC_API_KEY=sk-ant-...

# paper | live   (live is a stub — see src/trader.js)
MODE=paper

# Required to enable live mode (belt-and-suspenders)
LIVE_TRADING_CONFIRMED=no

# Starting paper portfolio in USD
PAPER_STARTING_USD=1000

# Max simultaneous open positions
MAX_OPEN_POSITIONS=3

# Scanner loop period (ms)
SCAN_INTERVAL_MS=30000

# Position monitor period (ms)
MONITOR_INTERVAL_MS=15000

# Tuner cadence (ms) — re-tunes parameters from recent journal
TUNE_INTERVAL_MS=21600000

# Models
MODEL_DECIDE=claude-haiku-4-5
MODEL_TUNE=claude-sonnet-4-6

# Which exchanges to scan: comma-separated subset of binance,coinbase,dexscreener
EXCHANGES=binance,coinbase,dexscreener

# Optional exchange keys (only needed when MODE=live)
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
